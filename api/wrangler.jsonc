{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "controle-presenca",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // App Flutter (build web) servido como Static Assets; só /api/* passa pelo Worker.
  "assets": {
    "directory": "../app/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Banco D1 de produção (criado em 13/11/2026). O desenvolvimento local e os testes
  // usam a cópia local do Wrangler, sem tocar neste banco.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "controle-presenca",
      "database_id": "75643dfd-1814-45ee-b9df-41991b43393d",
      "migrations_dir": "../db/migrations",
    },
  ],

  // Endereço público (custom domain criado pelo Wrangler no deploy).
  "routes": [{ "pattern": "controlepresenca.tghservices.com.br", "custom_domain": true }],
}
